{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "5025b464593349d09f85e2a45502c561",
    "m_Title": "① 文字の繰り返し数",
    "m_Content": "文字テクスチャは横長（例: 1024×128）なので、縦と横を同じ数だけ繰り返すと文字が潰れる。\n\n・Texture Size で画像の幅と高さを取り、幅 ÷ 高さ で「テクスチャの縦横比」を出す\n・Rows ÷ 縦横比 が「文字の形を保つには横に何枚並べればよいか」\n・Vector2(横の枚数, Rows) を Tiling として ④ で使う\n\nRows を変えても、画像を差し替えても、文字の形は自動で保たれる。",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -4682.39990234375,
        "y": -305.5999755859375,
        "width": 640.0,
        "height": 300.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

