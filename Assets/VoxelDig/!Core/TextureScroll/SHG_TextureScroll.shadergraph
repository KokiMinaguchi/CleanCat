{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "c0f9510a9a39406a82f81c2edd3f5cbf",
    "m_Title": "③ 時間 × 速さ",
    "m_Content": "Time（起動してからの秒数）× ScrollSpeed で、今どれだけ進んだかを求める。\n\n・Split の R（x）＝ 横に流れた量（単位: 文字テクスチャ何枚ぶん）→ ⑥ へ\n・Split の G（y）＝ 縦に流れた量（単位: 何行ぶん）→ ④ へ\n\nScrollSpeed の y を 0 にすると、行の傾きに沿って流れるだけになる。",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -4682.39990234375,
        "y": 734.4000244140625,
        "width": 640.0,
        "height": 259.99993896484377
    },
    "m_Group": {
        "m_Id": ""
    }
}

