{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "0992f95cf4744426a4dcd935445055f4",
    "m_Title": "⑦ テクスチャを読んで色を付ける",
    "m_Content": "完成した座標で MainTex を読む。\n\n・Canvas（UI）では、MainTex に RawImage / Image の画像がそのまま入る。\n　マテリアルに設定した画像は使われないので注意\n・テクスチャの A（不透明度）を Lerp の T に使い、\n　文字の部分は TextColor、それ以外は BackgroundColor にする\n・文字画像に透明な部分がない場合は、A の代わりに R を繋ぐ",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -620.0,
        "y": -300.0,
        "width": 900.0,
        "height": 280.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

