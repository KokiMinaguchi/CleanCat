{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "01a173089e314874813b942be4d7079a",
    "m_Title": "⑥ 横のずれ",
    "m_Content": "向き ＝ 偶奇 × 2 − 1　→　偶数行は −1、奇数行は +1\n横のずれ ＝ Fraction(横に流れた量) × 向き ＋ 偶奇 × 0.5\n\n・向きを掛けることで、1 行おきに逆方向へ流れる\n・偶奇 × 0.5 は、隣の行の文字を半分ずらして、縦に文字が揃わないようにするため\n・Fraction はここでも精度対策。文字 1 枚ぶんずれると元の見た目に戻るので、0〜1 に丸めても変わらない\n\n最後の Add で、④ の座標に Vector2(横のずれ, 0) を足す。\nこれでテクスチャを読む座標が完成。",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1722.4000244140625,
        "y": -305.5999755859375,
        "width": 900.0,
        "height": 400.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

