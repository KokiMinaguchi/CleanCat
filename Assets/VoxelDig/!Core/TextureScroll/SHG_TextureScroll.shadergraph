{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "55bcb43d5ea948b79f302194ad735e59",
    "m_Title": "このシェーダーについて",
    "m_Content": "文字テクスチャを何行も並べ、1行おきに逆方向へ斜めに流すシェーダー（Canvas / UI 用）。\n\n【処理の流れ】\n① 文字が潰れない横の繰り返し数を求める\n② UV を面の比率に直してから回転させる\n③ 時間 × 速さ で、どれだけ進んだかを求める\n④ 回転した UV をタイル単位の座標にし、縦のずれを足す\n⑤ いま何行目か、その偶数・奇数を調べる\n⑥ 偶数行と奇数行で逆向きになる横のずれを作る\n⑦ ずらした座標でテクスチャを読み、色を付ける\n\n【使い方】\n・RawImage の Texture に文字テクスチャを入れる\n　（Canvas では MainTex にマテリアルではなく RawImage の画像が入る）\n・テクスチャの Wrap Mode は Repeat にする\n・SurfaceAspect には RawImage の 幅 ÷ 高さ を入れる",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -4682.39990234375,
        "y": -705.5999755859375,
        "width": 640.0,
        "height": 360.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

