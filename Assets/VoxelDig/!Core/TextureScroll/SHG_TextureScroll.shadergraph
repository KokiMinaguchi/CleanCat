{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "61a6ca25b69847dc896ef2c3bb49fa07",
    "m_Title": "② 面の比率を補正して回転",
    "m_Content": "UV は横長の面でも 0〜1 の正方形として扱われる。そのまま回すと文字が斜めに歪む。\n\n・UV × Vector2(SurfaceAspect, 1) で、横方向を実際の長さに直してから回す\n・Angle（度）× 0.01745（= π ÷ 180）でラジアンに変換する\n・Rotate で回転する\n\n※ Rotate の Unit は Radians のままにすること。\n　Degrees にすると二重に変換されて、ほとんど回らなくなる。",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -4682.39990234375,
        "y": 44.79999923706055,
        "width": 640.0,
        "height": 329.6000061035156
    },
    "m_Group": {
        "m_Id": ""
    }
}

