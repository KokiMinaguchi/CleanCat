{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "94565587ee884a259b8cb1b155a4ee0d",
    "m_Title": "⑤ 行の偶数・奇数",
    "m_Content": "何行目かを表す G を 0.5 倍して Fraction を取ると、\n偶数行は 0〜0.5、奇数行は 0.5〜1 になる。\n\nStep（Edge = 0.5）は「0.5 以上なら 1、未満なら 0」を返すので、\n偶数行 → 0、奇数行 → 1 になる。これを「偶奇」と呼んで ⑥ で使う。\n\n※ Floor → Modulo で数える方法もあるが、回転で座標がマイナスになると\n　Modulo がマイナスを返して壊れる。\n　Fraction は負の数でも必ず 0〜1 を返すので安全。",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -2442.39990234375,
        "y": -305.5999755859375,
        "width": 599.9998779296875,
        "height": 400.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

